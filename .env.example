# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# .env.local wird nicht committet (siehe .gitignore).

# Dein Jev-API-Key von TypeSafe
VITE_JEV_API_KEY=

# Optional: Endpoint ueberschreiben. Standard laut Doku: https://api.typesafe.ai/v1/systemone
# VITE_JEV_API_URL=

# Modellname (laut oeffentlicher Beschreibung "jev-latest")
VITE_JEV_MODEL=jev-latest
